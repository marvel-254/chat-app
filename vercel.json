{
  "outputDirectory": "build/web",
  "framework": "other",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "(.*)\\.(js|css|wasm|png|jpg|webp|woff2?|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
