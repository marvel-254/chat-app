# Copy outside the checkout, customize and protect with host credentials ACLs.
listening-port=3478
tls-listening-port=5349
realm=turn.example.invalid
fingerprint
use-auth-secret
# Substitute via your host secret manager; do not commit the actual value.
static-auth-secret=REPLACE_ME
cert=/etc/letsencrypt/live/turn.example.invalid/fullchain.pem
pkey=/etc/letsencrypt/live/turn.example.invalid/privkey.pem
min-port=49160
max-port=49259
user-quota=12
total-quota=120
no-cli
no-loopback-peers
no-multicast-peers
# Restrict relay destinations reachable only from the TURN host; add your
# own additional deny ranges and firewall controls (including IPv6).
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
# If behind NAT, set external-ip=PUBLIC_IP/PRIVATE_IP with 1:1 port mapping.
